; YGONA SCARE — Godot 4.7.2
config_version=5

[application]
config/name="Ygona Scare"
config/icon="res://icon.png"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Survival horror 2.5D em perspectiva isometrica. A Ygona paralisa sob a luz; encontre tres fragmentos e conclua o ritual."

[display]
window/size/viewport_width=1152
window/size/viewport_height=720
window/stretch/mode="viewport"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.047, 0.075, 1)

[physics]
common/physics_ticks_per_second=60
